<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- This module was also published with a richer model, Gradle metadata,  -->
  <!-- which should be used instead. Do not delete the following line which  -->
  <!-- is to indicate to Gradle or any Gradle module metadata file consumer  -->
  <!-- that they should prefer consuming it instead. -->
  <!-- do_not_remove: published-with-gradle-metadata -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.autonomousapps</groupId>
  <artifactId>dependency-analysis-gradle-plugin</artifactId>
  <version>3.19.1</version>
  <name>Dependency Analysis Gradle Plugin</name>
  <description>Analyzes dependency usage in Android and JVM projects</description>
  <url>https://github.com/autonomousapps/dependency-analysis-android-gradle-plugin</url>
  <inceptionYear>2019</inceptionYear>
  <licenses>
    <license>
      <name>The Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>autonomousapps</id>
      <name>Tony Robalik</name>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:git://github.com/autonomousapps/dependency-analysis-android-gradle-plugin.git</connection>
    <developerConnection>scm:git:ssh://github.com/autonomousapps/dependency-analysis-android-gradle-plugin.git</developerConnection>
    <url>https://github.com/autonomousapps/dependency-analysis-android-gradle-plugin</url>
  </scm>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-bom</artifactId>
        <version>2.4.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.squareup.okio</groupId>
        <artifactId>okio-bom</artifactId>
        <version>3.15.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
